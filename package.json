{
  "name": "coloring-maze",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "染色迷宫：让弹珠沿直线滚到头，把木托盘迷宫的每一格都染上色（纯静态页面，部署到 Cloudflare Workers 静态资源）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "levels": "node tools/build-levels.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.2"
  }
}
