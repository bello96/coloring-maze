{
  // Cloudflare Workers 静态资源部署：游戏是纯前端，没有服务端代码。
  // 发布的是 `npm run build` 生成的 dist/ 目录。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coloring-maze",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "coloring-maze.dengjiabei.cn",
      "custom_domain": true
    }
  ]
}
